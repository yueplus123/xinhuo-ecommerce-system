# 薪火电商生产环境变量示例
# 复制为 .env 后填写真实值；.env 已被 Git 忽略。

BACKEND_SECRET_KEY=replace-with-a-long-random-secret
BACKEND_DEBUG=0
BACKEND_ALLOWED_HOSTS=your-domain.example,127.0.0.1
BACKEND_CORS_ALLOWED_ORIGINS=https://your-domain.example

# 企业微信订阅到期提醒
# WECOM_REMINDER_ENABLED=1
# WECOM_GROUP_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY
# STAFF_FRONTEND_BASE_URL=https://your-domain.example

# 外部系统收款推送
# EXTERNAL_PUSH_API_KEY=replace-with-a-different-long-random-secret
# EXTERNAL_PUSH_DEFAULT_USERNAME=admin
