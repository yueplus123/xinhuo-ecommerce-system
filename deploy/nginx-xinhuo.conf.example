# 示例：职员端 Vue + Django API/后台 + 静态资源（复制到 /etc/nginx/conf.d/ 并按实际 IP/路径调整）
# 要点：
# 1) default_server：避免 Host 为 127.0.0.1 等请求落到「只反代 Gunicorn」的默认站点，导致 /static、/media、/assets 全 404
# 2) 显式 location /assets/：Vue 打包的 JS/CSS，不依赖 try_files 兜底
# 3) /static/ 对应 collectstatic 输出目录 backend/staticfiles/

server {
    listen 80 default_server;
    server_name 192.144.236.133 127.0.0.1 localhost;

    client_max_body_size 50M;

    location /static/ {
        alias /opt/xinhuo/xinhuo-app/backend/staticfiles/;
        access_log off;
        expires 7d;
    }

    location /media/ {
        alias /opt/xinhuo/xinhuo-app/backend/media/;
        access_log off;
        expires 1d;
    }

    # Vue 生产构建（Vite）生成的 hashed 资源
    location /assets/ {
        alias /opt/xinhuo/xinhuo-app/frontend/dist/assets/;
        access_log off;
        expires 7d;
        add_header Cache-Control "public, immutable";
    }

    location /api/ {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://127.0.0.1:8001;
    }

    location /django-admin/ {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://127.0.0.1:8001;
    }

    location /backoffice/ {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://127.0.0.1:8001;
    }

    location /accounts/ {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://127.0.0.1:8001;
    }

    location / {
        root /opt/xinhuo/xinhuo-app/frontend/dist;
        try_files $uri $uri/ /index.html;
    }
}
