# 薪火电商：前后端分离部署（同一个 IP / 域名下按路径分流）
#
#   /        职员端前端   → frontend/dist
#   /admin/  管理后台前端 → admin/dist      （独立应用，自己的登录页，仅超级管理员可登录）
#   /api/    后端 API     → gunicorn 127.0.0.1:8001（纯 API，不含任何页面）
#   /media/  上传文件     → backend/media
#
# 使用：复制到 /etc/nginx/conf.d/xinhuo.conf，把 APP_ROOT 与 server_name 改成实际值，nginx -t 后 reload。

server {
    listen 80;
    server_name 192.144.236.133;

    client_max_body_size 50M;

    # ---------- 后端 API ----------
    location /api/ {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://127.0.0.1:8001;
    }

    # ---------- 上传文件 ----------
    location /media/ {
        alias /var/www/xinhuo/app/backend/media/;
    }

    # ---------- 管理后台前端（/admin/） ----------
    # 注意：alias 末尾必须带 /；SPA 回退到 admin 自己的 index.html
    location /admin/ {
        alias /var/www/xinhuo/app/admin/dist/;
        index index.html;
        try_files $uri $uri/ /admin/index.html;
    }

    # ---------- 职员端前端（其余所有路径） ----------
    location / {
        root /var/www/xinhuo/app/frontend/dist;
        try_files $uri $uri/ /index.html;
    }
}
